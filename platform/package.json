    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.3.3",
    "fastify-plugin": "^6.0.0",
    "google-auth-library": "^9.15.1",
    "imapflow": "^1.6.5",
    "mailparser": "^3.9.14",
    "pg": "^8.23.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.14.1",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.10",
