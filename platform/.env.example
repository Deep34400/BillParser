# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
# Local dev: Docker Postgres (docker-compose.dev.yml). Deployed: Cloud SQL, injected
# via Secret Manager (billparser-db-url-dev) — never set directly in a deployed .env.
DATABASE_URL=postgresql://billparser_app_dev:local_dev_password@localhost:5432/billparser_dev

# ─── GCP ──────────────────────────────────────────────────────────────────────
GCP_PROJECT_ID=carrum-doc-ai
STORAGE_BUCKET=carrum-doc-ai-uploads-dev

# ─── OCR Providers ────────────────────────────────────────────────────────────
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
VERTEX_LOCATION=global

# ─── Auth ─────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@praya.io
ADMIN_PASSWORD=admin123

# ─── Other ────────────────────────────────────────────────────────────────────
SIGNED_URL_TTL_MINUTES=60
BUYER_GSTIN_BLOCKLIST=

# Email intake (mailbox, password, enable, poll interval) is configured in
# Admin → Email Intake only. Nothing mail-related in .env.
# Defaults in code: imap.gmail.com:993, poll 90s.
