# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
LOCAL_DEV=true

# ─── GCP / Firestore ─────────────────────────────────────────────────────────
GCP_PROJECT_ID=billparser-dev
STORAGE_BUCKET=billparser-uploads
FIRESTORE_PREFIX=
FIRESTORE_DATABASE_ID=(default)

# ─── OCR Providers ────────────────────────────────────────────────────────────
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
VERTEX_LOCATION=global

# ─── Auth ─────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@praya.io
ADMIN_PASSWORD=admin123

# ─── Other ────────────────────────────────────────────────────────────────────
SIGNED_URL_TTL_MINUTES=60
BUYER_GSTIN_BLOCKLIST=

# Email intake (mailbox, password, enable, poll interval) is configured in
# Admin → Email Intake only. Nothing mail-related in .env.
# Defaults in code: imap.gmail.com:993, poll 90s.
