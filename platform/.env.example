# GCP Configuration
GCP_PROJECT_ID=billparser-dev
STORAGE_BUCKET=billparser-uploads

# Optional: Firestore collection prefix for multi-tenant isolation
FIRESTORE_PREFIX=

# OCR Provider Keys
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_MODEL=mistral-small-latest

# Gemini auth:
# - Local/dev: set GEMINI_API_KEY (AI Studio key), OR leave empty and use ADC:
#     gcloud auth application-default login
# - Cloud Run production: omit GEMINI_API_KEY — uses runtime service account (ADC) via Vertex AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
VERTEX_LOCATION=us-central1

# Local dev — in-memory DB + file storage (no GCP). Set false / omit for Firestore.
LOCAL_DEV=true

# Optional: buyer GSTINs to never treat as vendor (comma-separated)
# BUYER_GSTIN_BLOCKLIST=27AALCC8489R1ZD

# Authentication
JWT_SECRET=change-this-to-a-random-secret-in-production
ADMIN_EMAIL=admin@praya.io
ADMIN_PASSWORD=admin123

# Server
PORT=4000
NODE_ENV=development
