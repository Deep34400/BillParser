# GCP Configuration
GCP_PROJECT_ID=your-gcp-project
STORAGE_BUCKET=your-private-bucket
FIRESTORE_DATABASE_ID=(default)
# Or named DB e.g. billparser-db

FIRESTORE_PREFIX=

# false = Firestore + private GCS (requires ADC / service account)
LOCAL_DEV=true

SIGNED_URL_TTL_MINUTES=60

MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_MODEL=mistral-small-latest

# Gemini: leave empty to use Vertex + ADC on GCP
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
VERTEX_LOCATION=us-central1

JWT_SECRET=change-this-to-a-random-secret-in-production
ADMIN_EMAIL=admin@praya.io
ADMIN_PASSWORD=admin123

PORT=4000
NODE_ENV=development
